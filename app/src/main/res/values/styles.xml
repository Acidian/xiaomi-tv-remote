<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light theme (system light mode). Compose repaints everything; these values
         only prevent a mismatch during launch and while the window is being drawn. -->
    <style name="Theme.XiaomiTvRemote" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#F6F6FC</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
